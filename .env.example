# Variables de entorno de NFL-Predictor.
# Copia este fichero a `.env` y ajusta lo que necesites.
#
# Cualquier valor de config/settings.yaml puede sobrescribirse con el prefijo
# NFLP_ y doble guion bajo para anidar: NFLP_SECCION__CLAVE.

# --- Base de datos -----------------------------------------------------------
# "duckdb" (por defecto, sin servidor) o "postgresql"
NFLP_DATABASE__BACKEND=duckdb
# NFLP_DATABASE__POSTGRES_URL=postgresql+psycopg://nflp:nflp@localhost:5432/nflp

# --- Ingesta -----------------------------------------------------------------
NFLP_INGESTION__START_SEASON=2011
NFLP_INGESTION__END_SEASON=2026
# Subir este valor si Open-Meteo devuelve 429.
NFLP_WEATHER__REQUEST_DELAY_SECONDS=1.0

# --- Modelado ----------------------------------------------------------------
NFLP_MODELING__RANDOM_SEED=1729
NFLP_MODELING__OPTUNA_TRIALS=40

# --- Gate de promoción -------------------------------------------------------
# Brecha train/validación máxima tolerada antes de bloquear la promoción.
NFLP_MONITORING__MAX_TRAIN_VAL_GAP=0.15
NFLP_MONITORING__PSI_THRESHOLD=0.2
NFLP_MONITORING__SHADOW_WEEKS=2
NFLP_MONITORING__ROLLBACK_DEGRADATION=0.10

# --- MLflow ------------------------------------------------------------------
# El store de ficheros quedó en modo mantenimiento en MLflow 3: se usa SQLite.
NFLP_MLFLOW__TRACKING_URI=sqlite:///data/mlflow.db
# Con Docker Compose:
# NFLP_MLFLOW__TRACKING_URI=http://mlflow:5000

# --- Logging -----------------------------------------------------------------
NFLP_LOGGING__LEVEL=INFO

# --- Silenciar avisos de terceros --------------------------------------------
GIT_PYTHON_REFRESH=quiet
MLFLOW_DISABLE_AGENT_HINT=1

# --- Puertos de Docker Compose -----------------------------------------------
POSTGRES_PORT=5432
MLFLOW_PORT=5000
PREFECT_PORT=4200
DASHBOARD_PORT=8501
POSTGRES_USER=nflp
POSTGRES_PASSWORD=nflp
POSTGRES_DB=nflp
